    "menu": { "phrases": ["踊って", "踊れる", "ダンスして"], "cancel": "また今度ね。" },
    "songs": [
      {
        "motion": "mikumiku",
        "name": "ミクミク",
        "phrases": ["ミクミクにして"],
        "choices": ["ミクミク", "1番", "一番", "いちばん"]
      },
      {
        "motion": "tellyourworld",
        "name": "テルユアワールド",
        "phrases": ["テルユアワールド"],
        "choices": ["テルユア", "テル", "2番", "二番", "にばん"]
      },
      {
        "motion": "tellyourworld_full",
        "name": "テルユアワールド完全版",
        "phrases": ["テルユアワールド完全版"],
        "choices": ["完全版", "3番", "三番", "さんばん"]
      }
