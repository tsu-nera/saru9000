{
  "character": "saru",
  "listen_mode": "wake",
  "calendar_entity": "calendar.yotei",
  "home_denylist": [
    "sensor.*_active_window_title",
    "sensor.*_wi_fi_ssid",
    "sensor.*_wi_fi_bssid",
    "sensor.*_connection_state",
    "sensor.*_last_used_app",
    "sensor.backup_*",
    "sensor.*_version",
    "sensor.*_basetime"
  ],
  "service_denylist": [
    "homeassistant.*",
    "hassio.*",
    "recorder.*",
    "backup.*",
    "update.*",
    "lock.*",
    "alarm_control_panel.*",
    "shell_command.*",
    "rest_command.*",
    "automation.*",
    "script.reload"
  ],
  "voicevox_url": "http://127.0.0.1:50021",
  "open_jtalk": {
    "bin": "~/.local/opt/open_jtalk/bin/open_jtalk",
    "dic": "~/.local/opt/open_jtalk/open_jtalk_dic_utf_8-1.11"
  },
