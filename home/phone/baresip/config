# 発信ごとに server.py が一時ディレクトリへコピーし、audio_source・audio_player・audio_alert の行を足す。
# audio_alert は読み上げの wav と別のファイルにする（着信音の書き出しで読み上げが上書きされる）
sip_listen		0.0.0.0:5070
# vaio の resolv.conf は Tailscale の DNS（IPv6 を含む）で、baresip が Address family not supported になる
dns_server		1.1.1.1:53
module_path		/usr/lib/baresip/modules
module			g711.so
# Linphone 側が SRTP 必須。accounts で mediaenc=srtp-mand にする（srtp だと 488）
module			srtp.so
module			aufile.so
# medianat（stun・ice）は入れない。rtp_listen failed: af=AF_UNSPEC で発信できなくなる。音声は Linphone のサーバが中継する
module_app		menu.so
module_app		account.so
sip_trace		no
