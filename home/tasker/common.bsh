// 各スクリプトが source() で読み込む共通部分。Tasker の「Java コード」アクション（BeanShell）で動く。
// 設定（HA の URL・webhook ID・WiMAX のパスワード）は repo に置かず、スマホの config.properties から読む。
import java.io.File;
import java.io.FileInputStream;
import java.io.FileWriter;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.util.Date;
import java.util.Properties;
import org.json.JSONObject;

DIR = "/sdcard/Download/saru9000";

loadConfig() {
  Properties p = new Properties();
  FileInputStream in = new FileInputStream(DIR + "/config.properties");
  p.load(in);
  in.close();
  return p;
}

log(String msg) {
  FileWriter f = new FileWriter(DIR + "/battery.log", true);
  f.write(new Date() + " " + msg + "\n");
  f.close();
}

readText(String path) {
  File file = new File(path);
  if (!file.exists()) return null;
  byte[] b = new byte[(int) file.length()];
  FileInputStream in = new FileInputStream(file);
  in.read(b);
  in.close();
  return new String(b, "UTF-8");
}

// query.bsh が返す「機器ごとの最後の値と時刻」
saveLast(String device, int level) {
  String path = DIR + "/last.json";
  String text = readText(path);
  JSONObject all = text == null ? new JSONObject() : new JSONObject(text);
  JSONObject one = new JSONObject();
  one.put("level", level);
  one.put("at", new Date().getTime() / 1000);
  all.put(device, one);
  FileWriter f = new FileWriter(path);
  f.write(all.toString());
  f.close();
}

// HA の webhook へ {"device": ..., "level": ...} を送る。HTTP ステータスを返す
postBattery(String device, int level) {
  Properties p = loadConfig();
  URL u = new URL(p.getProperty("ha_url") + "/api/webhook/" + p.getProperty("webhook_id"));
  HttpURLConnection c = (HttpURLConnection) u.openConnection();
  c.setRequestMethod("POST");
  c.setDoOutput(true);
  c.setConnectTimeout(15000);
  c.setReadTimeout(15000);
  c.setRequestProperty("Content-Type", "application/json");
  JSONObject body = new JSONObject();
  body.put("device", device);
  body.put("level", level);
  OutputStream o = c.getOutputStream();
  o.write(body.toString().getBytes("UTF-8"));
  o.close();
  int code = c.getResponseCode();
  c.disconnect();
  saveLast(device, level);
  log(device + " " + level + " -> HTTP " + code);
  return code;
}
